{
	"name": "@thgilciffart/pi-websearch",
	"version": "0.2.1",
	"description": "Web search tool for the pi coding agent with one web_search tool, 10 providers, automatic fallback, and direct API calls, so a search costs the API price, not model tokens.",
	"type": "module",
	"license": "MIT",
	"author": "thgilciffart",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"web-search",
		"websearch",
		"search",
		"ai",
		"agents"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thgilciffart/pi-web-search.git"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"typebox": "1.3.27"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"check": "npm run typecheck && npm test",
		"prepublishOnly": "npm run check"
	}
}

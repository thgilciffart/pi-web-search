{
	"name": "pi-websearch",
	"version": "0.1.0",
	"description": "Web search tool for the pi coding agent — one web_search tool, 10 providers (Tavily, Brave, Serper, Exa, Perplexity, You.com, Parallel, Linkup, SearXNG, DuckDuckGo) with automatic provider fallback. Calls search APIs directly, so a search costs the API price, not model tokens.",
	"type": "module",
	"license": "MIT",
	"author": "thgilciffart",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"web-search",
		"websearch",
		"search",
		"ai",
		"agents"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thgilciffart/pi-web-search.git"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	}
}
